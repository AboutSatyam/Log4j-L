<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status="INFO">

    <Appenders>
        <Console name="LoggingToConsole" target="SYSTEM_OUT">
            <PatternLayout>
                <Pattern>
                    %d - %c - [%M] - (%p) - %m - %n
                </Pattern>
            </PatternLayout>
        </Console>

        <File name ="LoggingToFile">

        </File>
    </Appenders>

    <Loggers>
        <Root level="warn">
            <AppenderRef ref="LoggingToConsole"/>
        </Root>
    </Loggers>

</Configuration>
